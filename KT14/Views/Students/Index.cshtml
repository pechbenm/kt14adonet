@model IEnumerable<KT14.Models.Student>
@{ ViewData["Title"] = "Студенты"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Студенты</h1>
    <a asp-action="Create" class="btn btn-primary">Добавить студента</a>
</div>

<table class="table table-hover align-middle">
    <thead><tr><th>ФИО</th><th>Email</th><th>Дата рождения</th><th>Курсов</th><th></th></tr></thead>
    <tbody>
    @foreach (var s in Model)
    {
        <tr>
            <td>@s.FullName</td>
            <td>@s.Email</td>
            <td>@s.BirthDate.ToString("dd.MM.yyyy")</td>
            <td>@s.Courses.Count</td>
            <td class="text-end">
                <a asp-action="Details" asp-route-id="@s.Id" class="btn btn-sm btn-outline-secondary">Открыть</a>
                <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary">Изменить</a>
                <form asp-action="Delete" asp-route-id="@s.Id" method="post" class="d-inline"
                      onsubmit="return confirm('Удалить студента? Он будет отчислен со всех курсов.');">
                    <button class="btn btn-sm btn-outline-danger">Удалить</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
@if (!Model.Any())
{
    <p class="text-muted">Студентов пока нет.</p>
}

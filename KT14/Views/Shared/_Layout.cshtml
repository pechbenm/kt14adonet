<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — Учебный центр</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <nav class="navbar navbar-expand navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Courses" asp-action="Index">Учебный центр</a>
            <div class="navbar-nav">
                <a class="nav-link" asp-controller="Courses" asp-action="Index">Курсы</a>
                <a class="nav-link" asp-controller="Teachers" asp-action="Index">Преподаватели</a>
                <a class="nav-link" asp-controller="Students" asp-action="Index">Студенты</a>
            </div>
        </div>
    </nav>
    <main class="container pb-5">
        @RenderBody()
    </main>
</body>
</html>

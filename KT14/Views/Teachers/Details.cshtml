@model KT14.Models.Teacher
@{ ViewData["Title"] = Model.FullName; }

<h1 class="h3">@Model.FullName</h1>
<p class="text-muted">@Model.Email @(string.IsNullOrEmpty(Model.Department) ? "" : "· " + Model.Department)</p>

<h2 class="h5 mt-4">Курсы (@Model.Courses.Count)</h2>
@if (Model.Courses.Any())
{
    <table class="table align-middle">
        <thead><tr><th>Название</th><th>Кредиты</th><th>Студентов</th></tr></thead>
        <tbody>
        @foreach (var c in Model.Courses.OrderBy(c => c.Title))
        {
            <tr>
                <td><a asp-controller="Courses" asp-action="Details" asp-route-id="@c.Id">@c.Title</a></td>
                <td>@c.Credits</td>
                <td>@c.Students.Count</td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">Курсы не назначены. Назначить преподавателя можно при создании или изменении курса.</p>
}

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Изменить</a>
<a asp-action="Index" class="btn btn-link">К списку</a>
